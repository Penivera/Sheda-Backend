/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sheda",
	"main": "src/main.py",
	"compatibility_date": "2026-09-21",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"ACCESS_TOKEN_EXPIRE_MINUTES": "30",
		"ADMIN_PREFIX": "sheda-backend",
		"ADMIN_PRIMARY_COLOR": "#c62828",
		"ADMIN_ROUTE": "/sheda-backend",
		"ADMIN_SECRET_KEY": "your-admin-secret-key-different-from-jwt",
		"ADMIN_SEED_EMAIL": "peni@peni.dev",
		"ADMIN_SEED_ENABLED": "False",
		"ADMIN_SEED_PASSWORD": "admin",
		"ADMIN_SEED_USERNAME": "Penivera",
		"ADMIN_SITE_FAVICON": "/static/sheda-solutions.png",
		"ADMIN_SITE_HEADER_LOGO": "/static/sheda-solutions.png",
		"ADMIN_SITE_NAME": "Sheda Admin",
		"ADMIN_SITE_SIGN_IN_LOGO": "/static/sheda-solutions.png",
		"ADMIN_USER_MODEL": "Admin",
		"ADMIN_USER_MODEL_USERNAME_FIELD": "username",
		"ALGORITHM": "HS256",
		"ALLOW_HEADERS": "[\"Content-Type\", \"Authorization\", \"X-Requested-With\", \"Accept\", \"Origin\", \"Access-Control-Allow-Origin\", \"Access-Control-Allow-Methods\", \"Access-Control-Allow-Headers\"]",
		"API_V_STR": "/api/v1",
		"CLOUDINARY_API_KEY": "your-cloudinary-api-key",
		"CLOUDINARY_API_SECRET": "your-cloudinary-api-secret",
		"CLOUDINARY_NAME": "doajfmh7f",
		"CLOUDINARY_URL": "cloudinary://api_key:api_secret@cloud_name",
		"DB_URL": "postgresql+asyncpg://user:password@localhost:5432/sheda",
		"DEBUG_MODE": "True",
		"DEV_URL": "http://localhost:8000",
		"GOOGLE_CLIENT_ID": "333938897540-tt7udprd6mf22erf0go6nfonkn7hqkit.apps.googleusercontent.com",
		"METHODS": "[\"GET\", \"POST\", \"PUT\", \"DELETE\", \"OPTIONS\"]",
		"ORIGINS": "[\"*\"]",
		"PINATA_API_KEY": "your-pinata-api-key",
		"PINATA_API_SECRET": "your-pinata-api-secret",
		"PINATA_GATEWAY_URL": "https://maroon-reasonable-squid-257.mypinata.cloud",
		"PINATA_JWT": "your-pinata-jwt-token",
		"PINATA_URL": "https://uploads.pinata.cloud/v3/files",
		"PROD_URL": "https://sheda.peni.dev",
		"REDIS_URL": "redis://localhost:6379/0",
		"REFRESH_TOKEN_EXPIRE_DAYS": "20",
		"SECRET_KEY": "your-super-secret-jwt-key-change-this-in-production",
		"SIGN_UP_DESC": "Once accounts are created they are stored temporarily for 2 hours before deletion if email verification is not completed",
		"SMTP_HOST": "smtp-relay.brevo.com",
		"SMTP_PORT": "2525",
		"SMTP_SEND_FROM_MAIL": "sheda-solutions@penivera.me",
		"SMTP_USERNAME": "your-email@gmail.com",
		"VERIFICATION_CODE_EXP_MIN": "15"
	}
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}